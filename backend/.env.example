# Port the Express server listens on.
PORT=3000

# Comma-separated list of browser origins allowed to call this API.
# Development: leave empty. The Vite dev server proxies /api to this backend,
# so the browser only ever talks to one origin and CORS never applies.
# Production: set the exact origin of the deployed frontend, e.g. https://app.example.com
CORS_ORIGIN=

# Base URL of the GitHub REST API.
GITHUB_API_BASE_URL=https://api.github.com

# Optional personal access token. Raises the GitHub rate limit from 60 to 5000
# requests per hour. Server-side only: never expose this to the frontend.
GITHUB_TOKEN=
